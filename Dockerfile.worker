# Use Python 3.11 slim base image
FROM python:3.11-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies including OCR tools and Chromium deps for Playwright
RUN apt-get update && apt-get install -y \
    curl \
    gcc \
    g++ \
    libc6-dev \
    libpq-dev \
    tesseract-ocr \
    tesseract-ocr-fra \
    libtesseract-dev \
    poppler-utils \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    # Chromium system deps required by Playwright
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r tenderai && useradd -r -g tenderai tenderai

# Set work directory
WORKDIR /app

# Install Poetry
RUN pip install poetry==1.8.3

# Configure Poetry
ENV POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_CREATE=false \
    POETRY_CACHE_DIR=/tmp/poetry_cache

# Copy dependency files
COPY pyproject.toml poetry.lock* README.md ./

# Install dependencies with full extras (includes playwright)
RUN poetry install --only=main --extras "full" --no-root && rm -rf $POETRY_CACHE_DIR

# Install Playwright Chromium to a fixed path accessible by the tenderai user
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN playwright install chromium && chmod -R 755 /ms-playwright

# Copy application code
COPY src/ src/

# Install the package itself in editable mode
RUN pip install -e .

# Create necessary directories with proper permissions
RUN mkdir -p logs/nodes cache temp reports /tmp/ocr && \
    chmod -R 777 logs cache temp reports /tmp/ocr && \
    chown -R tenderai:tenderai /app /tmp/ocr

# Set Tesseract path
ENV TESSERACT_PATH=/usr/bin/tesseract

# Switch to non-root user
USER tenderai

# Health check (worker doesn't expose HTTP port, so check process via /proc)
HEALTHCHECK --interval=60s --timeout=30s --start-period=120s --retries=3 \
    CMD python3 -c "import os,sys; sys.exit(0 if any('schedule' in open(f'/proc/{p}/cmdline','rb').read().decode(errors='ignore') for p in os.listdir('/proc') if p.isdigit()) else 1)"

# Command to run scheduler (cron-based pipeline execution)
CMD ["python", "-m", "tenderai.cli", "run-scheduler"]